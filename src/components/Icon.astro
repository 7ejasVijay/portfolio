---
// Phosphor icons (regular weight everywhere for one consistent stroke).
const icons = import.meta.glob('/node_modules/@phosphor-icons/core/assets/regular/*.svg', { query: '?raw', import: 'default', eager: true });
const { name, class: cls = 'size-4' } = Astro.props;
const svg = icons[`/node_modules/@phosphor-icons/core/assets/regular/${name}.svg`];
if (!svg) throw new Error(`Unknown icon: ${name}`);
---
<span class:list={['inline-flex shrink-0 [&>svg]:size-full', cls]} aria-hidden="true" set:html={svg} />

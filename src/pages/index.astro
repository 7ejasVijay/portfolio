---
// Homepage: a compact cluster of small cards on a dark, code-doodle background with an orange accent.
// Cards open modals with the full details. The sun button switches light/dark.
// The previous bento homepage lives at /bento.
import '@fontsource/caveat/600.css';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BrandIcon from '../components/BrandIcon.astro';
import ClaudeMate from '../components/ClaudeMate.astro';
import * as si from 'simple-icons';
import { site, experience, featured, projects, skills, education, interests, techGrid } from '../data.js';

const work = [featured, ...projects];
const faceRec = projects.find(p => p.id === 'face-recognition');
const dex = projects.find(p => p.id === 'polkadex');
const brandName = slug => si[`si${slug[0].toUpperCase()}${slug.slice(1)}`].title.replace('Parity ', '');
const mostUsed = ['rust', 'tauri', 'typescript', 'svelte'];
const stack = techGrid.slice(0, 9);

// Candlestick chart for the project card (Backtest Engine). Seeded so it never changes.
function rng(a: number) { return () => { a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }
const r = rng(42);
let price = 120;
const candles = Array.from({ length: 22 }, (_, i) => {
  const open = price, close = open + (r() - 0.42) * 14;
  price = close;
  return { x: 8 + i * 9, open, close, high: Math.max(open, close) + r() * 6, low: Math.min(open, close) - r() * 6 };
});
const y = (v: number) => 150 - (v - 60) * 0.9;
const equity = candles.map((c, i) => `${i ? 'L' : 'M'} ${c.x + 2} ${y(c.close) - 18}`).join(' ');
---
<Base title={`${site.name}, ${site.title}`} bare>
  <div class="home min-h-[100dvh]" data-mode="dark">
    <script is:inline>
      // Apply the saved mode before paint.
      try { const m = localStorage.getItem('home-mode'); if (m) document.currentScript.parentElement.dataset.mode = m; } catch {}
    </script>

    <div class="mx-auto max-w-[62rem] px-4 py-10 sm:px-6 md:py-16">
      <div class="cluster">

        <!-- Brand + mode -->
        <a href="/" class="area-logo self-center text-xl font-bold text-[var(--accent)]">TejasGaware<span class="text-[var(--text)]">.</span></a>
        <button id="mode" type="button" class="area-mode grid size-10 place-items-center justify-self-end rounded-full text-[var(--accent)] transition-transform duration-500 ease-spring hover:rotate-45" aria-label="Switch light or dark mode">
          <span class="icon-sun"><Icon name="sun" class="size-6" /></span><span class="icon-moon"><Icon name="moon" class="size-6" /></span>
        </button>

        <!-- Headline -->
        <div data-reveal class="area-hero self-end md:pl-[12%]">
          <p class="text-sm font-medium text-[var(--text)]">Full Stack Developer</p>
          <h1 class="mt-2 text-[2.6rem] leading-[1.02] font-extrabold tracking-tight text-[var(--accent)] sm:text-6xl">Building Products<br>End to End.</h1>
        </div>

        <!-- Years of experience -->
        <section data-reveal style="--i:1" class="area-years card flex items-center gap-4 self-end px-5 py-3 md:justify-self-end md:w-[calc(50%+0.45rem)]" aria-label="5+ years of experience">
          <p class="years-num text-5xl leading-none font-extrabold tracking-tight text-[var(--accent)]">5+</p>
          <p class="copy text-sm leading-snug font-medium text-[var(--text)]">years shipping<br><em>software</em></p>
        </section>

        <!-- Contacts -->
        <section data-reveal style="--i:1" class="area-contact card p-5">
          <h2 class="label">Contacts</h2>
          <ul class="mt-4 grid grid-cols-2 gap-2.5">
            <li><a href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="icon-tile"><Icon name="linkedin-logo" class="size-7" /></a></li>
            <li><a href={site.github} target="_blank" rel="noopener" aria-label="GitHub" class="icon-tile"><Icon name="github-logo" class="size-7" /></a></li>
          </ul>
        </section>

        <!-- Most used -->
        <div data-reveal style="--i:2" class="area-used relative self-end">
          <p class="note absolute -top-11 right-0 hidden md:block" aria-hidden="true">
            <svg viewBox="0 0 60 40" class="note-arrow absolute top-3 -left-14 w-14"><path d="M56 6 C36 4 18 12 10 30 M10 30 L6 21 M10 30 L18 26" /></svg>Most Used
          </p>
          <ul class="card flex items-center justify-around px-4 py-2.5" aria-label="Most used tools">
            {mostUsed.map(t => <li title={brandName(t)}><BrandIcon slug={t} class="size-6" /></li>)}
          </ul>
        </div>

        <!-- About -->
        <section data-reveal class="area-about card relative flex flex-col p-5">
          <h2 class="label">About Me</h2>
          <p class="copy mt-3 flex-1 text-[0.95rem] leading-relaxed text-[var(--text)]">
            I'm <em>Tejas</em>, a full stack engineer passionate about <em>Rust backends</em>, <em>blockchain</em> and <em>clean interfaces</em>. I build complete products end to end, with Claude as my first mate.
          </p>
          <button type="button" data-open="about" class="arrow-btn mt-3 self-end" aria-label="More about me"><Icon name="arrow-up-right" class="size-4" /></button>
        </section>

        <!-- Project -->
        <section data-reveal style="--i:1" class="area-project card group relative overflow-hidden">
          <svg viewBox="0 0 210 170" preserveAspectRatio="xMidYMid slice" class="chart absolute inset-0 h-full w-full" aria-hidden="true">
            {[30, 60, 90, 120, 150].map(gy => <path d={`M0 ${gy} H210`} class="grid-line" />)}
            {candles.map(c => (
              <g class={c.close >= c.open ? 'up' : 'down'}>
                <path d={`M ${c.x + 2} ${y(c.high)} V ${y(c.low)}`} />
                <rect x={c.x} y={y(Math.max(c.open, c.close))} width="4.5" height={Math.max(1.5, Math.abs(y(c.open) - y(c.close)))} />
              </g>
            ))}
            <path d={equity} class="equity" />
          </svg>
          <div class="shade absolute inset-0"></div>
          <div class="relative flex h-full flex-col justify-end p-4">
            <h2 class="text-lg font-bold tracking-wide text-white uppercase">Project</h2>
            <div class="flex items-end justify-between gap-3">
              <p class="copy text-sm leading-snug text-white/85">{featured.name}: Rust engine, Tauri app, full web UI.</p>
              <button type="button" data-open="projects" class="arrow-btn shrink-0" aria-label="See all projects"><Icon name="arrow-up-right" class="size-4" /></button>
            </div>
          </div>
        </section>

        <!-- Tech stack -->
        <section data-reveal style="--i:2" class="area-stack card flex flex-col p-5">
          <div class="flex items-center justify-between">
            <h2 class="label">Tech Stack</h2>
            <button type="button" data-open="skills" class="arrow-btn size-7" aria-label="All skills"><Icon name="arrow-up-right" class="size-3.5" /></button>
          </div>
          <ul class="mt-4 grid grid-cols-3 justify-items-center gap-x-3 gap-y-4">
            {stack.map(t => <li data-roll title={brandName(t)} class="tech"><BrandIcon slug={t} class="size-7" /></li>)}
          </ul>
        </section>

        <!-- Gallery -->
        <section data-reveal style="--i:3" class="area-gallery card relative overflow-hidden">
          <img src="/photo.jpg" alt="Tejas Gaware" width="460" height="460" class="absolute inset-0 h-full w-full object-cover object-top" />
          <div class="shade absolute inset-0"></div>
          <h2 class="label relative p-4 text-white/90">Gallery</h2>
          <ul class="absolute inset-x-3 bottom-12 flex flex-wrap gap-1.5">
            {interests.map(t => <li class="rounded-full bg-black/45 px-2.5 py-0.5 text-xs text-white">{t}</li>)}
          </ul>
          <ClaudeMate />
        </section>

        <!-- Currently -->
        <div data-reveal style="--i:1" class="area-learn relative self-start">
          <p class="card copy px-4 py-2.5 text-center text-sm font-medium text-[var(--text)]">Currently Building <em>{featured.name}</em></p>
        </div>

        <!-- Polkadex (current role) -->
        <section data-reveal style="--i:1" class="area-dex card group relative overflow-hidden">
          <img src={dex.image} alt={dex.imageAlt} width="1600" height="975" loading="lazy" class="absolute inset-0 h-full w-full object-cover object-top" />
          <div class="shade absolute inset-0"></div>
          <div class="relative flex h-full flex-col justify-end p-4">
            <div class="flex items-end justify-between gap-3">
              <div>
                <p class="text-xs font-medium tracking-wide text-[var(--accent)] uppercase">{dex.context}</p>
                <h2 class="mt-0.5 text-lg font-bold text-white">{dex.name}</h2>
                <p class="copy text-sm text-white/85">{dex.tagline}</p>
              </div>
              <a href="/projects/polkadex" class="arrow-btn card-link shrink-0" aria-label={`Read about ${dex.name}`}><Icon name="arrow-up-right" class="size-4" /></a>
            </div>
          </div>
        </section>

        <!-- Face recognition (SAIG internship) -->
        <section data-reveal style="--i:2" class="area-saig card group relative overflow-hidden">
          <img src={faceRec.image} alt={faceRec.imageAlt} width="1400" height="781" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
          <div class="shade absolute inset-0"></div>
          <div class="relative flex h-full flex-col justify-end p-4">
            <div class="flex items-end justify-between gap-3">
              <div>
                <p class="text-xs font-medium tracking-wide text-[var(--accent)] uppercase">{faceRec.context}</p>
                <h2 class="mt-0.5 text-lg font-bold text-white">{faceRec.name}</h2>
                <p class="copy text-sm text-white/85">GoPro feed + one-shot learning, recognising people live.</p>
              </div>
              <a href="/projects/face-recognition" class="arrow-btn card-link shrink-0" aria-label={`Read about ${faceRec.name}`}><Icon name="arrow-up-right" class="size-4" /></a>
            </div>
          </div>
        </section>

      </div>
    </div>

    <!-- Modals -->
    <dialog id="dlg-about" class="modal m-auto" aria-labelledby="dlg-about-title">
      <header class="modal-head"><h2 id="dlg-about-title">About me</h2><form method="dialog"><button class="close" aria-label="Close"><Icon name="x" /></button></form></header>
      <div class="modal-body space-y-6">
        <p class="leading-relaxed">I started in <strong>data science and AI</strong>, moved into <strong>backend and blockchain infrastructure</strong>, and now build complete products: the data layer, the services, and the interfaces people touch. I ship faster with AI in the loop, and my first mate is <strong>Claude</strong>. The judgment calls stay mine.</p>
        <div>
          <h3 class="label">Experience</h3>
          <ol class="mt-3 space-y-5">
            {experience.map(e => (
              <li class="border-l-2 border-[var(--accent)] pl-4">
                <p class="text-xs text-[var(--muted)]">{e.period}</p>
                <p class="font-semibold">{e.role} <span class="text-[var(--accent)]">@ {e.company}</span></p>
                <ul class="mt-1.5 space-y-1 text-sm text-[var(--muted)]">{e.points.map(p => <li>{p}</li>)}</ul>
              </li>
            ))}
          </ol>
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
          <div><h3 class="label">Education</h3><ul class="mt-3 space-y-2 text-sm">{education.map(e => <li><span class="font-semibold">{e.degree}</span><br><span class="text-[var(--muted)]">{e.school}</span></li>)}</ul></div>
          <div><h3 class="label">Off the clock</h3><p class="mt-3 text-sm">{interests.join(', ')}</p></div>
        </div>
      </div>
    </dialog>

    <dialog id="dlg-projects" class="modal m-auto" aria-labelledby="dlg-projects-title">
      <header class="modal-head"><h2 id="dlg-projects-title">Projects</h2><form method="dialog"><button class="close" aria-label="Close"><Icon name="x" /></button></form></header>
      <ul class="modal-body grid gap-3 sm:grid-cols-2">
        {work.map(p => (
          <li class:list={['rounded-xl border border-[var(--line)] bg-[var(--card-2)] p-4', p.status && 'sm:col-span-2']}>
            <p class="font-semibold">{p.name} {p.status && <span class="ml-1 rounded-full bg-[var(--accent)] px-2 py-0.5 text-xs font-semibold text-[#1c1c1c]">In progress</span>}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-[var(--muted)]">{p.desc}</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">{p.stack.map(t => <li class="rounded-full border border-[var(--line)] px-2.5 py-0.5 text-xs">{t}</li>)}</ul>
            {p.links?.length > 0 && <div class="mt-3 flex gap-4 text-sm">{p.links.map(l => <a href={l.href} target="_blank" rel="noopener" class="text-[var(--accent)] hover:underline">{l.label} ↗</a>)}</div>}
          </li>
        ))}
      </ul>
    </dialog>

    <dialog id="dlg-skills" class="modal m-auto" aria-labelledby="dlg-skills-title">
      <header class="modal-head"><h2 id="dlg-skills-title">Tech stack</h2><form method="dialog"><button class="close" aria-label="Close"><Icon name="x" /></button></form></header>
      <div class="modal-body">
        <ul class="grid grid-cols-4 gap-2 sm:grid-cols-6">
          {techGrid.map(t => <li class="flex flex-col items-center gap-1.5 rounded-xl bg-[var(--card-2)] py-3 text-center"><BrandIcon slug={t} class="size-6" /><span class="text-[0.65rem] text-[var(--muted)]">{brandName(t)}</span></li>)}
        </ul>
        <dl class="mt-6 grid gap-x-6 gap-y-4 sm:grid-cols-2">
          {Object.entries(skills).map(([g, items]) => <div><dt class="label">{g}</dt><dd class="mt-1 text-sm">{items.join(', ')}</dd></div>)}
        </dl>
        <a href="/play" class="direct mt-6 inline-block w-auto px-5">Play Snake</a>
      </div>
    </dialog>
  </div>
</Base>

<script>
  const home = document.querySelector<HTMLElement>('.home')!;
  document.getElementById('mode')!.addEventListener('click', () => {
    const next = home.dataset.mode === 'dark' ? 'light' : 'dark';
    home.dataset.mode = next;
    try { localStorage.setItem('home-mode', next); } catch {}
  });

  document.querySelectorAll<HTMLElement>('[data-open]').forEach(b => b.addEventListener('click', () => {
    (document.getElementById(`dlg-${b.dataset.open}`) as HTMLDialogElement).showModal();
  }));
  document.querySelectorAll<HTMLDialogElement>('dialog.modal').forEach(d => d.addEventListener('click', e => { if (e.target === d) d.close(); }));
</script>

<style>

  /* Layout: mobile stacks; desktop is a 4-column cluster. */
  .cluster { display: grid; gap: 0.9rem; grid-template-columns: 1fr auto; grid-template-areas: 'logo mode' 'hero hero' 'years years' 'contact contact' 'used used' 'about about' 'project project' 'dex dex' 'saig saig' 'stack stack' 'gallery gallery' 'learn learn'; }
  @media (min-width: 768px) {
    .cluster {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-areas:
        'logo  logo    logo   mode'
        'hero  hero    hero   contact'
        'years years   used   contact'
        'about project stack  gallery'
        'learn .       .      gallery'
        'dex   dex     saig   saig';
    }
    .area-about, .area-project { min-height: 17rem; }
    .area-gallery { min-height: 21rem; }
  }
  .area-logo { grid-area: logo; } .area-mode { grid-area: mode; } .area-hero { grid-area: hero; } .area-contact { grid-area: contact; }
  .area-used { grid-area: used; } .area-about { grid-area: about; } .area-project { grid-area: project; } .area-stack { grid-area: stack; }
  .area-gallery { grid-area: gallery; } .area-learn { grid-area: learn; } .area-years { grid-area: years; } .area-saig { grid-area: saig; min-height: 15rem; } .area-dex { grid-area: dex; min-height: 15rem; }
  @media (max-width: 767px) { .area-project { min-height: 15rem; } .area-gallery { min-height: 22rem; } }

  /* Cards */
  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.85rem;
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.6), inset 0 1px 0 rgb(255 255 255 / 0.04);
    transition: transform 0.5s var(--ease-bounce), box-shadow 0.4s, background-color 0.4s;
  }
  .card:hover { transform: translateY(-4px); box-shadow: 0 26px 50px -24px rgb(0 0 0 / 0.7), inset 0 1px 0 rgb(255 255 255 / 0.05); }
  .label { font-size: 0.75rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .copy em { font-style: normal; font-weight: 600; color: var(--accent); }

  .icon-tile { display: grid; place-items: center; aspect-ratio: 1; border-radius: 0.7rem; background: var(--card-2); color: var(--text); transition: color 0.2s, transform 0.3s var(--ease-bounce); }
  .icon-tile:hover { color: var(--accent); transform: translateY(-2px); }
  .direct { display: block; width: 100%; text-align: center; border-radius: 0.6rem; background: var(--accent); color: #1c1c1c; font-weight: 800; font-size: 1.15rem; padding: 0.45rem 0; transition: filter 0.2s, transform 0.2s; }
  .direct:hover { filter: brightness(1.08); }
  .direct:active { transform: scale(0.98); }
  .arrow-btn { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 9999px; background: var(--accent); color: #1c1c1c; transition: transform 0.4s var(--ease-bounce); }
  .arrow-btn:hover { transform: rotate(45deg) scale(1.1); }
  .tech { transition: transform 0.4s var(--ease-bounce); }
  .tech:hover { transform: translateY(-3px) scale(1.12); }

  /* Handwritten notes with drawn arrows */
  .note { font-family: 'Caveat', cursive; font-weight: 600; font-size: 1.15rem; color: var(--text); white-space: nowrap; }
  .note-arrow { fill: none; stroke: var(--text); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 80; stroke-dashoffset: 80; }
  .in .note-arrow { animation: draw 0.9s ease-out 0.6s forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .note-arrow { stroke-dashoffset: 0; } }

  /* Project chart and photo shading */
  .chart { background: #161616; transition: transform 0.8s var(--ease-spring); }
  .chart .grid-line { stroke: rgb(255 255 255 / 0.06); }
  .chart .up path, .chart .up rect { stroke: #f5a623; fill: #f5a623; }
  .chart .down path, .chart .down rect { stroke: #6b6b6b; fill: #6b6b6b; }
  .chart .equity { fill: none; stroke: #fff; stroke-width: 1.5; stroke-opacity: 0.55; stroke-dasharray: 4 3; }
  .group:hover .chart { transform: scale(1.05); }
  .shade { background: linear-gradient(to top, rgb(0 0 0 / 0.75), rgb(0 0 0 / 0.1) 55%, rgb(0 0 0 / 0.6)); }

  /* Modals */
  .modal { width: min(44rem, calc(100% - 2rem)); max-height: 86dvh; padding: 0; overflow-y: auto; border: 1px solid var(--line); border-radius: 1rem; background: var(--card); color: var(--text); box-shadow: 0 40px 100px -30px rgb(0 0 0 / 0.8); }
  .modal[open] { animation: modal-in 0.45s var(--ease-bounce); }
  @keyframes modal-in { from { opacity: 0; transform: translateY(16px) scale(0.96); } }
  .modal::backdrop { background: rgb(0 0 0 / 0.6); backdrop-filter: blur(3px); }
  .modal-head { position: sticky; top: 0; z-index: 1; display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.4rem; background: var(--card); border-bottom: 1px solid var(--line); }
  .modal-head h2 { font-size: 1.25rem; font-weight: 800; color: var(--accent); }
  .modal-body { padding: 1.4rem; }
  /* Whole project card is clickable through its arrow link. */
  .card-link::after { content: ''; position: absolute; inset: 0; }


  .close { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 9999px; background: var(--card-2); color: var(--text); }
</style>

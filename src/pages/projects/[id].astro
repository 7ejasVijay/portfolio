---
// Editorial project page, one per Markdown file in src/content/projects/.
// Chapters are the article's h2s; a "kicker" paragraph before each gives its date.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data.js';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const p = entry.data;
const chapters = headings.filter(h => h.depth === 2);
const words = (entry.body ?? '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(words / 220));
const monthName = (ym: string) => new Date(`${ym}-01T00:00:00Z`).toLocaleString('en', { month: 'short', timeZone: 'UTC' });
const maxCommits = p.activity ? Math.max(...p.activity.months.map(([, n]) => n)) : 0;
const totalCommits = p.activity ? p.activity.months.reduce((a, [, n]) => a + n, 0) : 0;
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title={`${p.title}, ${site.name}`} description={p.tagline} bare>
  <div class="home min-h-[100dvh]" data-mode="dark">
    <script is:inline>
      try { const m = localStorage.getItem('home-mode'); if (m) document.currentScript.parentElement.dataset.mode = m; } catch {}
    </script>
    <div class="progress" aria-hidden="true"></div>

    <div class="mx-auto max-w-[72rem] px-4 py-6 sm:px-6 md:py-10">
      <nav class="flex items-center justify-between">
        <a href="/" class="inline-flex items-center gap-2 text-sm font-medium text-[var(--muted)] hover:text-[var(--accent)]"><Icon name="arrow-left" class="size-4" />TejasGaware<span class="text-[var(--accent)]">.</span></a>
        <button id="mode" type="button" class="grid size-10 place-items-center rounded-full text-[var(--accent)]" aria-label="Switch light or dark mode">
          <span class="icon-sun"><Icon name="sun" class="size-6" /></span><span class="icon-moon"><Icon name="moon" class="size-6" /></span>
        </button>
      </nav>

      <!-- Hero -->
      <header class="mt-14 max-w-[56rem] md:mt-20">
        <p class="text-xs font-semibold tracking-[0.18em] text-[var(--accent)] uppercase">Case study · {p.context}</p>
        <h1 class="hero-title mt-4">{p.title}</h1>
        <p class="mt-6 max-w-[44rem] text-xl leading-relaxed text-[var(--muted)] sm:text-2xl">{p.tagline}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-[var(--muted)]">
          <span class="inline-flex items-center gap-2.5 text-[var(--text)]">
            <img src="/photo.jpg" alt="" width="36" height="36" class="size-9 rounded-full object-cover object-top" />
            <span class="font-semibold">{site.name}</span>
          </span>
          <span>{readMinutes} min read</span>
          {p.period && <span>{p.period}</span>}
        </div>
      </header>

      <figure class="mt-12">
        <img src={p.cover.src} alt={p.cover.alt} class="cover block w-full rounded-2xl" fetchpriority="high" />
        {p.cover.caption && <figcaption class="mt-3 text-sm text-[var(--muted)]">{p.cover.caption}</figcaption>}
      </figure>

      <!-- Body: sticky chapter list beside the article -->
      <div class="mt-16 lg:grid lg:grid-cols-[13rem_minmax(0,44rem)] lg:justify-center lg:gap-16">
        <aside class="hidden lg:block" aria-label="Chapters">
          <div class="sticky top-10">
            <p class="text-xs font-semibold tracking-[0.18em] text-[var(--muted)] uppercase">Chapters</p>
            <ol class="toc mt-4 space-y-1">
              {chapters.map((h, i) => (
                <li><a href={`#${h.slug}`} data-toc={h.slug} class="toc-link"><span class="toc-num">{pad(i + 1)}</span><span>{h.text}</span></a></li>
              ))}
            </ol>
          </div>
        </aside>

        <div class="min-w-0">
          <!-- At a glance -->
          <section class="glance" aria-label="At a glance">
            <p class="text-xs font-semibold tracking-[0.18em] text-[var(--muted)] uppercase">At a glance</p>
            {p.stats.length > 0 && (
              <ul class="mt-4 grid grid-cols-3 gap-4">
                {p.stats.map(s => <li><p class="text-4xl font-extrabold tracking-tight text-[var(--accent)]">{s.value}</p><p class="mt-1 text-xs leading-snug text-[var(--muted)]">{s.label}</p></li>)}
              </ul>
            )}
            {p.activity && (
              <figure class="mt-7">
                <figcaption class="flex items-baseline justify-between gap-3 text-sm">
                  <span class="font-semibold">{p.activity.title}</span>
                  <span class="text-[var(--muted)]">{totalCommits.toLocaleString('en')} total</span>
                </figcaption>
                <ol class="mt-4 flex h-28 items-end gap-1.5" aria-label={p.activity.title}>
                  {p.activity.months.map(([ym, n]) => (
                    <li class="flex h-full flex-1 flex-col items-center justify-end gap-1.5" title={`${monthName(ym)} ${ym.slice(0, 4)}: ${n} commits`}>
                      <span class="text-[0.65rem] text-[var(--muted)]">{n || ''}</span>
                      <span class="bar w-full rounded-t-[3px]" style={`height:${n ? Math.max(4, (n / maxCommits) * 100) : 1.5}%`}></span>
                      <span class="text-[0.6rem] text-[var(--muted)]">{monthName(ym)}</span>
                    </li>
                  ))}
                </ol>
                <p class="mt-2 flex justify-between text-[0.65rem] text-[var(--muted)]"><span>{p.activity.months[0][0].slice(0, 4)}</span><span>{p.activity.months.at(-1)[0].slice(0, 4)}</span></p>
              </figure>
            )}
            {p.stack.length > 0 && (
              <ul class="mt-6 flex flex-wrap gap-1.5">{p.stack.map(t => <li class="rounded-full border border-[var(--line)] px-3 py-1 text-xs">{t}</li>)}</ul>
            )}
          </section>

          <article class="prose mt-14">
            <Content />
          </article>

          <!-- Outro -->
          <footer class="mt-16 border-t border-[var(--line)] pt-8">
            {p.links.length > 0 && (
              <>
                <p class="text-xs font-semibold tracking-[0.18em] text-[var(--muted)] uppercase">Explore</p>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {p.links.map(l => <li><a href={l.href} target="_blank" rel="noopener" class="chip-link">{l.label}<Icon name="arrow-up-right" class="size-3.5" /></a></li>)}
                </ul>
              </>
            )}
            <div class="mt-10 flex items-center justify-between text-sm">
              <a href="/" class="inline-flex items-center gap-2 font-semibold text-[var(--accent)] hover:underline"><Icon name="arrow-left" class="size-4" />Back to all work</a>
              <a href={site.linkedin} target="_blank" rel="noopener" class="text-[var(--muted)] hover:text-[var(--accent)]">Say hi on LinkedIn</a>
            </div>
          </footer>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  const home = document.querySelector<HTMLElement>('.home')!;
  document.getElementById('mode')!.addEventListener('click', () => {
    const next = home.dataset.mode === 'dark' ? 'light' : 'dark';
    home.dataset.mode = next;
    try { localStorage.setItem('home-mode', next); } catch {}
  });

  // Highlight the chapter currently being read.
  const links = document.querySelectorAll<HTMLElement>('[data-toc]');
  const spy = new IntersectionObserver(entries => {
    for (const e of entries) if (e.isIntersecting) links.forEach(l => l.classList.toggle('is-active', l.dataset.toc === e.target.id));
  }, { rootMargin: '-20% 0px -70% 0px' });
  document.querySelectorAll('.prose h2[id]').forEach(h => spy.observe(h));
</script>

<style>
  /* Reading progress, driven by scroll position (no JS). */
  .progress { position: fixed; inset: 0 0 auto; z-index: 50; height: 3px; background: var(--accent); transform-origin: left; transform: scaleX(0); }
  @supports (animation-timeline: scroll()) {
    .progress { animation: read linear both; animation-timeline: scroll(root); }
    @keyframes read { to { transform: scaleX(1); } }
  }

  .hero-title { font-size: clamp(3.5rem, 11vw, 8rem); line-height: 0.9; font-weight: 800; letter-spacing: -0.04em; }
  .cover { border: 1px solid var(--line); box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.7); }

  .toc-link { display: flex; gap: 0.7rem; padding: 0.4rem 0.6rem; border-radius: 0.5rem; font-size: 0.85rem; line-height: 1.35; color: var(--muted); transition: color 0.2s, background 0.2s; }
  .toc-link:hover { color: var(--text); }
  .toc-link.is-active { color: var(--text); background: var(--card); }
  .toc-num { font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent); padding-top: 0.1rem; }

  .glance { border-radius: 1.1rem; background: var(--card); border: 1px solid var(--line); padding: 1.5rem; }
  .bar { background: var(--accent); }
  .chip-link { display: inline-flex; align-items: center; gap: 0.3rem; border: 1px solid var(--line); border-radius: 9999px; padding: 0.4rem 0.9rem; font-size: 0.85rem; font-weight: 600; background: var(--card); transition: border-color 0.2s, color 0.2s; }
  .chip-link:hover { border-color: var(--accent); color: var(--accent); }

  /* ---------- Article ---------- */
  .prose { font-size: 1.09rem; line-height: 1.85; color: var(--text); }
  .prose :global(p) { margin-top: 1.2rem; }
  .prose :global(strong) { color: var(--accent); font-weight: 700; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.85em; background: var(--card); border: 1px solid var(--line); border-radius: 0.35rem; padding: 0.05rem 0.35rem; }

  /* Opening paragraph: larger, with a drop cap. */
  .prose > :global(p:first-child) { font-size: 1.25rem; line-height: 1.7; }
  .prose > :global(p:first-child::first-letter) { float: left; margin: 0.35rem 0.6rem 0 0; font-size: 4.2rem; line-height: 0.8; font-weight: 800; color: var(--accent); }

  /* Chapters: date kicker + numbered heading on a timeline rail. */
  .prose { counter-reset: chapter; }
  .prose :global(.kicker) { position: relative; margin-top: 4.5rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); }
  .prose :global(.kicker::before) { content: ''; display: inline-block; width: 1.6rem; height: 2px; margin-right: 0.6rem; vertical-align: middle; background: var(--accent); }
  .prose :global(h2) { counter-increment: chapter; scroll-margin-top: 2rem; margin-top: 0.4rem; font-size: clamp(1.8rem, 4vw, 2.4rem); line-height: 1.1; font-weight: 800; letter-spacing: -0.02em; }
  .prose :global(h2::before) { content: counter(chapter, decimal-leading-zero) ' '; color: var(--muted); font-weight: 600; opacity: 0.6; }
  .prose :global(h2 + p) { margin-top: 1rem; }

  .prose :global(blockquote) { margin: 2.4rem 0; padding: 0.4rem 0 0.4rem 1.6rem; border-left: 4px solid var(--accent); }
  .prose :global(blockquote p) { margin: 0; font-size: clamp(1.4rem, 3vw, 1.85rem); line-height: 1.3; font-weight: 700; letter-spacing: -0.01em; }

  .prose :global(figure) { margin: 2.6rem 0; }
  .prose :global(figure img) { display: block; width: 100%; border-radius: 1rem; border: 1px solid var(--line); box-shadow: 0 30px 60px -36px rgb(0 0 0 / 0.65); }
  .prose :global(figcaption) { margin-top: 0.75rem; padding-left: 0.8rem; border-left: 2px solid var(--line); font-size: 0.85rem; line-height: 1.5; color: var(--muted); }
  .prose :global(figure.pair) { display: grid; gap: 0.8rem; align-items: start; }
  @media (min-width: 640px) { .prose :global(figure.pair) { grid-template-columns: 0.75fr 1fr; } }
  .prose :global(figure.pair figcaption) { grid-column: 1 / -1; }

  /* Code samples. */
  .prose :global(figure.code pre) { overflow-x: auto; border: 1px solid var(--line); border-radius: 1rem; background: var(--card); padding: 1.2rem 1.4rem; font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.7; }
  .prose :global(figure.code code) { border: 0; background: none; padding: 0; font-size: inherit; }

  /* Bullet lists in the article. */
  .prose > :global(ul) { margin-top: 1rem; padding-left: 1.2rem; list-style: disc; }
  .prose > :global(ul li) { margin-top: 0.4rem; padding-left: 0.2rem; }
  .prose > :global(ul li::marker) { color: var(--accent); }

  /* Vertical pipeline: numbered steps joined by a line, each with the tool it uses. */
  .prose :global(figure.steps ol) { position: relative; list-style: none; padding: 0; counter-reset: step; }
  .prose :global(figure.steps ol::before) { content: ''; position: absolute; left: 1.05rem; top: 1rem; bottom: 1rem; width: 2px; background: var(--line); }
  .prose :global(figure.steps li) { position: relative; counter-increment: step; display: grid; grid-template-columns: 2.1rem 1fr; column-gap: 1rem; padding: 0.7rem 0; }
  .prose :global(figure.steps li::before) { content: counter(step); grid-row: span 3; display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 9999px; background: var(--card); border: 2px solid var(--accent); font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700; color: var(--accent); z-index: 1; }
  .prose :global(figure.steps b) { font-size: 1.05rem; line-height: 1.3; }
  .prose :global(figure.steps span) { font-size: 0.92rem; line-height: 1.55; color: var(--muted); }
  .prose :global(figure.steps em) { justify-self: start; margin-top: 0.4rem; border: 1px solid var(--line); border-radius: 9999px; padding: 0.05rem 0.6rem; font-style: normal; font-family: var(--font-mono); font-size: 0.72rem; color: var(--text); background: var(--card); }

  /* Step diagram: numbered cards in a row, linked by arrows on wide screens. */
  .prose :global(figure.flow ol) { display: grid; gap: 0.75rem; counter-reset: step; list-style: none; padding: 0; }
  @media (min-width: 640px) { .prose :global(figure.flow ol) { grid-template-columns: repeat(4, 1fr); } }
  .prose :global(figure.flow li) { position: relative; counter-increment: step; border: 1px solid var(--line); border-radius: 0.9rem; background: var(--card); padding: 1rem; font-size: 0.85rem; line-height: 1.45; color: var(--muted); }
  .prose :global(figure.flow li::before) { content: counter(step, decimal-leading-zero); display: block; font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent); }
  .prose :global(figure.flow b) { display: block; margin: 0.3rem 0 0.25rem; font-size: 1.05rem; color: var(--text); }
  @media (min-width: 640px) { .prose :global(figure.flow li:not(:last-child)::after) { content: '→'; position: absolute; right: -0.7rem; top: 50%; translate: 0 -50%; z-index: 1; color: var(--accent); font-weight: 800; } }
</style>
